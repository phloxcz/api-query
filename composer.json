{
    "name": "phloxcz/api-query",
    "description": "Query language for Phlox APIs: Kendo UI compatible filtering, sorting, paging and field selection over entities, resources and SQL, limited to declared fields.",
    "keywords": ["nette", "api", "query", "filter", "kendo"],
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/phloxcz/api-query",
    "authors": [
        {
            "name": "Phlox",
            "homepage": "https://github.com/phloxcz"
        }
    ],
    "repositories": [
        {
            "type": "path",
            "url": "../phlox-api-core",
            "options": {
                "versions": {
                    "phloxcz/api-core": "0.1.x-dev"
                }
            }
        },
        {
            "type": "path",
            "url": "../phlox-entity-database",
            "options": {
                "versions": {
                    "phloxcz/entity-database": "0.1.x-dev"
                }
            }
        },
        {
            "type": "path",
            "url": "../phlox-firebird-database",
            "options": {
                "versions": {
                    "phloxcz/firebird-database": "0.1.x-dev"
                }
            }
        },
        {
            "type": "path",
            "url": "../phlox-rest-api",
            "options": {
                "versions": {
                    "phloxcz/rest-api": "0.1.x-dev"
                }
            }
        },
        {
            "type": "path",
            "url": "../phlox-rpc-api",
            "options": {
                "versions": {
                    "phloxcz/rpc-api": "0.1.x-dev"
                }
            }
        }
    ],
    "require": {
        "php": ">=8.4",
        "nette/database": "^3.2",
        "nette/di": "^3.1",
        "nette/schema": "^1.3",
        "nette/utils": "^4.0",
        "phloxcz/api-core": "^0.1@dev",
        "phloxcz/entity-database": "^0.1@dev"
    },
    "require-dev": {
        "nette/application": "^3.2",
        "nette/bootstrap": "^3.2",
        "nette/caching": "^3.2",
        "nette/tester": "^2.5",
        "phloxcz/firebird-database": "^0.1@dev",
        "phloxcz/rest-api": "^0.1@dev",
        "phloxcz/rpc-api": "^0.1@dev",
        "phpstan/phpstan": "^2.0",
        "tracy/tracy": "^2.10"
    },
    "autoload": {
        "psr-4": {
            "Phlox\\ApiQuery\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Phlox\\ApiQuery\\Tests\\Fixtures\\": "tests/fixtures/"
        }
    },
    "scripts": {
        "test": "tester tests -C",
        "phpstan": "phpstan analyse",
        "check": [
            "@phpstan",
            "@test"
        ]
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-master": "0.1-dev"
        }
    }
}
